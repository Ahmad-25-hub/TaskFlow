# Isi API key dari https://aistudio.google.com/apikey
# Dibaca PHP saja. Jangan gunakan awalan VITE_ untuk API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: konfigurasi XAMPP lokal
TASKFLOW_DB_HOST=127.0.0.1
TASKFLOW_DB_PORT=3306
TASKFLOW_DB_NAME=taskflow
TASKFLOW_DB_USER=root
TASKFLOW_DB_PASSWORD=
